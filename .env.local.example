# Neon / PostgreSQL
DATABASE_URL=postgresql://user:password@host/database

# NextAuth v4
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-secret
# Optional: if omitted, NextAuth uses NEXTAUTH_SECRET for JWT signing.
NEXTAUTH_JWT_SECRET=replace-with-a-random-secret

# Google Cloud Console OAuth client
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google

# Stripe Payment Links / webhook
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
# Payment Links live in credit_packages.stripe_payment_link.
# Never expose these Stripe secrets to the browser.
